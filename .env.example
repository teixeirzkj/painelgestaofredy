# ---------------------------------------------------------------------------
# Desenvolvimento local (SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# Gere um segredo forte em produção: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-troque-em-producao-0123456789abcdef"
# Segredo do agendador de automações (/api/cron/automacoes). Na Vercel o Cron envia esse valor automaticamente.
CRON_SECRET="dev-cron-secret"
# Segredo do webhook do provedor de assinatura eletrônica (preencher quando a ZapSign for configurada)
SIGNATURE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Produção (Vercel) — configure em Project Settings → Environment Variables
# ---------------------------------------------------------------------------
# DATABASE_URL           → criada pela integração Neon (conexão com pooling)
# DATABASE_URL_UNPOOLED  → criada pela integração Neon (conexão direta, usada nas migrações)
# AUTH_SECRET            → 64 caracteres aleatórios (obrigatório)
# CRON_SECRET            → 32+ caracteres aleatórios (obrigatório para as automações)
# PLATFORM_BOOTSTRAP_EMAIL / PLATFORM_BOOTSTRAP_PASSWORD
#                        → primeiro acesso ao /plataforma (senha com 10+ caracteres). Remova após o primeiro login.
# STORAGE_DRIVER         → opcional; na Vercel o padrão é "database" (arquivos no PostgreSQL)
