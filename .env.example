# Desenvolvimento local (SQLite). Em produção use PostgreSQL — veja README.
DATABASE_URL="file:./dev.db"
# Gere um segredo forte em produção: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-troque-em-producao-0123456789abcdef"
# Segredo exigido pelo endpoint de agendamento de automações (/api/cron/automations)
CRON_SECRET="dev-cron-secret"
# Segredo para o webhook do provedor de assinatura eletrônica (ainda não integrado)
SIGNATURE_WEBHOOK_SECRET=""
