// Frédy Gestão — modelo de dados
//
// Convenções:
// - Valores monetários: inteiros em CENTAVOS (sufixo Cents). Nunca float.
// - Datas de calendário (vencimento, data da venda, viagem): String "YYYY-MM-DD",
//   interpretadas no fuso horário da agência (Company.timezone).
// - Timestamps (createdAt etc.): DateTime UTC.
// - "Enums" são String validadas na aplicação (src/lib/constants.ts), para manter o
//   schema portável entre SQLite (desenvolvimento) e PostgreSQL (produção).
// - Toda entidade de negócio possui companyId (isolamento multi-tenant).
// - Lançamentos gerados automaticamente têm sourceKey único por empresa (idempotência).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Para produção com PostgreSQL troque para "postgresql" (veja README).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String   @id @default(cuid())
  name                String
  document            String?
  timezone            String   @default("America/Sao_Paulo")
  isDemo              Boolean  @default(false)
  active              Boolean  @default(true) // conta suspensa pela plataforma = ninguém entra
  suspendedReason     String?
  logoKey             String? // logo da agência (armazenamento interno)
  plan                String   @default("PADRAO")
  maxUsers            Int      @default(5)
  createdByPlatformId String?
  commissionPayDay    Int      @default(5) // dia do mês seguinte para pagamento de comissões
  upcomingDueDays     Int      @default(5) // janela de "próximo do vencimento"
  upcomingTripDays    Int      @default(7) // janela de "viagem próxima"
  webhookUrl          String? // destino genérico de eventos (opcional)
  webhookSecret       String?
  apiKeyHash          String? // chave para API de eventos (hash SHA-256)
  tradeName           String? // nome fantasia
  contactEmail        String?
  contactPhone        String?
  address             String?
  responsibleName     String? // responsável legal (contratos)
  responsibleDocument String?
  responsibleRole     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users              User[]
  rolePermissions    RolePermission[]
  clients            Client[]
  passengers         Passenger[]
  suppliers          Supplier[]
  sales              Sale[]
  saleItems          SaleItem[]
  reservations       Reservation[]
  receivables        Receivable[]
  payables           Payable[]
  settlements        Settlement[]
  accounts           FinancialAccount[]
  transfers          Transfer[]
  commissions        Commission[]
  contractTemplates  ContractTemplate[]
  contracts          Contract[]
  automationSettings AutomationSetting[]
  automationEvents   AutomationEvent[]
  fredyIntegration   FredyIntegration?
  fredyEvents        FredyWebhookEvent[]
  signatureRequests  SignatureRequest[]
  mondeIntegration   MondeIntegration?
  auditLogs          AuditLog[]
  attachments        Attachment[]
  statementLines     BankStatementLine[]
  trips              Trip[]
  excursions         Excursion[]
  supplierInvoices   SupplierInvoice[]
  costCenters        CostCenter[]
  commissionRules    CommissionRule[]
  clientCredits      ClientCredit[]
  editRequests       EditRequest[]
  agencyTransfers    AgencyTransfer[]
  goals              Goal[]
  tasks              Task[]
  expenseCategories  ExpenseCategory[]
  cardFeeRates       CardFeeRate[]
  accessLogs         AccessLog[]
}

model User {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  email             String    @unique
  passwordHash      String
  role              String // ADMIN | GESTOR | VENDEDOR | FINANCEIRO
  active            Boolean   @default(true)
  commissionRateBps Int       @default(0) // % padrão de comissão sobre a receita da agência (basis points)
  birthDate         String?
  phone             String?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  salesAsSeller Sale[]       @relation("SaleSeller")
  salesCreated  Sale[]       @relation("SaleCreatedBy")
  commissions   Commission[]
  clientsOwned  Client[]
  auditLogs     AuditLog[]

  @@index([companyId])
}

/// Sobrescritas de permissão por perfil e empresa (permissões configuráveis).
model RolePermission {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       String
  permission String
  allowed    Boolean

  @@unique([companyId, role, permission])
}

model Client {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  personType       String    @default("PF") // PF | PJ
  tradeName        String? // nome fantasia (PJ)
  document         String? // CPF ou CNPJ (somente dígitos)
  rg               String?
  passportNumber   String? // dado sensível: opcional, exibido mascarado
  passportExpiry   String?
  specialNeeds     String? // necessidades especiais/restrições relevantes para a viagem
  phone            String?
  whatsapp         String?
  email            String?
  birthDate        String?
  zipCode          String?
  street           String?
  number           String?
  complement       String?
  district         String?
  city             String?
  state            String?
  notes            String?
  consentMessaging Boolean   @default(false) // consentimento para comunicações automáticas (LGPD)
  fredyContactId   String? // vínculo futuro com o contato no CRM Frédy
  mondeId          String? // id da pessoa no Monde (importação)
  ownerId          String?
  owner            User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  sales       Sale[]
  passengers  Passenger[]
  receivables Receivable[]
  payables    Payable[]
  trips       Trip[]
  credits     ClientCredit[]
  tasks       Task[]
  attachments Attachment[]

  @@unique([companyId, document])
  @@index([companyId, mondeId])
  @@index([companyId, name])
}

model Passenger {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name           String
  document       String?
  birthDate      String?
  passportNumber String? // dado sensível: opcional, exibido mascarado
  passportExpiry String?
  room           String? // rooming list (excursões/grupos)
  seat           String? // assento/poltrona (ônibus, excursões)
  createdAt      DateTime @default(now())

  @@index([companyId, saleId])
}

model Supplier {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  document     String? // CNPJ
  contactName  String?
  email        String?
  phone        String?
  category     String // OPERADORA | CIA_AEREA | HOTEL | CONSOLIDADORA | SEGURADORA | RECEPTIVO | TRANSPORTADORA | INTERMEDIARIO | OUTROS
  billingCycle String    @default("AVULSO") // AVULSO | DECENDIAL | QUINZENAL | MENSAL (faturas consolidadas)
  bankInfo     String?
  pixKey       String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  saleItems          SaleItem[]
  operatedItems      SaleItem[]        @relation("ItemOperator")
  payables           Payable[]
  receivables        Receivable[]
  reservations       Reservation[]
  invoices           SupplierInvoice[]
  commissionRules    CommissionRule[]
  intermediatedSales Sale[]            @relation("SaleIntermediary")

  @@index([companyId, name])
}

model Sale {
  id                          String     @id @default(cuid())
  companyId                   String
  company                     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number                      Int
  code                        String // ex.: V-2026-0001
  saleDate                    String
  clientId                    String
  client                      Client     @relation(fields: [clientId], references: [id])
  sellerId                    String
  seller                      User       @relation("SaleSeller", fields: [sellerId], references: [id])
  createdById                 String
  createdBy                   User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  mainProductType             String
  destination                 String?
  tripStart                   String?
  tripEnd                     String?
  passengerCount              Int        @default(1)
  locator                     String?
  tripId                      String?
  trip                        Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  excursionId                 String?
  excursion                   Excursion? @relation(fields: [excursionId], references: [id], onDelete: SetNull)
  intermediaryId              String? // intermediário/freelancer (fornecedor da categoria INTERMEDIARIO)
  intermediary                Supplier?  @relation("SaleIntermediary", fields: [intermediaryId], references: [id], onDelete: SetNull)
  intermediaryCommissionCents Int        @default(0)
  origin                      String     @default("MANUAL") // MANUAL | API (orçamento recebido por integração)
  externalRef                 String? // referência externa (ex.: id do orçamento no CRM)
  status                      String // ORCAMENTO | CONFIRMADA | CONCLUIDA | CANCELADA
  // Valores calculados (centavos) — recalculados a cada alteração
  feesCents                   Int        @default(0)
  discountCents               Int        @default(0)
  grossCents                  Int        @default(0) // faturamento comercial
  clientPayableCents          Int        @default(0) // valor que o cliente paga à agência
  costCents                   Int        @default(0) // custos/repasses a fornecedores
  agencyRevenueCents          Int        @default(0) // receita própria da agência
  sellerCommissionCents       Int        @default(0)
  grossProfitCents            Int        @default(0)
  marginBps                   Int        @default(0)
  paymentPlanJson             String     @default("[]") // parcelas planejadas [{key, dueDate, amountCents, method, description}]
  notes                       String?
  confirmedAt                 DateTime?
  reviewedAt                  DateTime? // conferida pelo financeiro (edição passa a exigir solicitação aprovada)
  reviewedById                String?
  cancelledAt                 DateTime?
  cancelReason                String?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  items        SaleItem[]
  passengers   Passenger[]
  reservations Reservation[]
  receivables  Receivable[]
  payables     Payable[]
  commission   Commission?
  contracts    Contract[]

  attachments  Attachment[]
  editRequests EditRequest[]

  @@unique([companyId, number])
  @@unique([companyId, code])
  @@unique([companyId, externalRef])
  @@index([companyId, saleDate])
  @@index([companyId, tripId])
  @@index([companyId, sellerId])
}

model SaleItem {
  id                      String    @id @default(cuid())
  companyId               String
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId                  String
  sale                    Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productType             String // AEREO | HOTEL | PACOTE | CRUZEIRO | SEGURO | PASSEIO | TRANSFER | OUTROS
  description             String?
  supplierId              String?
  supplier                Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  commercialModel         String // INTERMEDIACAO | REVENDA | COMISSAO
  priceCents              Int // valor vendido ao cliente
  costCents               Int       @default(0) // custo/repasse ao fornecedor (INTERMEDIACAO/REVENDA)
  supplierCommissionCents Int       @default(0) // comissão paga pelo fornecedor (modelo COMISSAO)
  operatorId              String? // operadora/consolidadora que fatura o produto (quando diferente do fornecedor)
  operator                Supplier? @relation("ItemOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  ravCents                Int       @default(0) // taxa RAV cobrada do cliente (receita da agência)
  duCents                 Int       @default(0) // taxa DU cobrada do cliente (receita da agência)
  overCents               Int       @default(0) // incentivo (over) pago pelo fornecedor
  cardFeeCents            Int       @default(0) // taxa CC RAV/DU retida pelo fornecedor (cliente pagou direto no cartão)
  supplierDueDate         String? // vencimento do repasse / recebimento da comissão
  locator                 String?
  sortOrder               Int       @default(0)

  reservation Reservation?

  @@index([companyId, saleId])
}

model Reservation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId      String
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItemId  String    @unique
  saleItem    SaleItem  @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  productType String
  locator     String?
  startDate   String?
  endDate     String?
  status      String // PENDENTE | CONFIRMADA | CANCELADA
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, startDate])
}

model Receivable {
  id                String      @id @default(cuid())
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceKey         String? // idempotência de lançamentos automáticos
  origin            String // VENDA | COMISSAO_FORNECEDOR | MANUAL
  clientId          String?
  client            Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleId            String?
  sale              Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  description       String
  category          String      @default("VENDAS")
  costCenterId      String?
  costCenter        CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  amountCents       Int // valor original
  settledCents      Int         @default(0) // valor abatido do saldo (inclui descontos concedidos na baixa)
  receivedCents     Int         @default(0) // dinheiro efetivamente recebido (inclui juros)
  dueDate           String
  method            String?
  installmentNumber Int?
  installmentCount  Int?
  status            String // PENDENTE | PARCIAL | PAGO | CANCELADO  (VENCIDO é derivado)
  notes             String?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  settlements Settlement[]
  attachments Attachment[]

  @@unique([companyId, sourceKey])
  @@index([companyId, dueDate])
  @@index([companyId, status])
}

model Payable {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceKey         String?
  origin            String // CUSTO_VENDA | COMISSAO_VENDEDOR | MANUAL | RECORRENTE
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleId            String?
  sale              Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItemId        String?
  commissionId      String?          @unique
  commission        Commission?      @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  clientId          String? // reembolsos a clientes
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoiceId         String? // fatura do fornecedor que consolida este lançamento
  invoice           SupplierInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  costCenterId      String?
  costCenter        CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  excursionId       String?
  excursion         Excursion?       @relation(fields: [excursionId], references: [id], onDelete: SetNull)
  description       String
  category          String // FORNECEDORES | SALARIOS | COMISSOES | ALUGUEL | MARKETING | SISTEMAS | IMPOSTOS | ADMINISTRATIVAS | OUTROS
  amountCents       Int
  settledCents      Int              @default(0)
  paidCents         Int              @default(0)
  dueDate           String
  method            String?
  installmentNumber Int?
  installmentCount  Int?
  recurrenceGroup   String?
  status            String
  notes             String?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  settlements Settlement[]
  attachments Attachment[]

  @@unique([companyId, sourceKey])
  @@index([companyId, dueDate])
  @@index([companyId, status])
  @@index([companyId, invoiceId])
}

/// Baixa financeira (recebimento ou pagamento). Nunca é apagada: estornos marcam reversedAt.
model Settlement {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind             String // RECEBIMENTO | PAGAMENTO
  receivableId     String?
  receivable       Receivable?      @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  payableId        String?
  payable          Payable?         @relation(fields: [payableId], references: [id], onDelete: Restrict)
  accountId        String
  account          FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date             String
  amountCents      Int // dinheiro movimentado
  interestCents    Int              @default(0)
  discountCents    Int              @default(0)
  method           String?
  notes            String?
  createdById      String?
  reversedAt       DateTime?
  reversalReason   String?
  cardInstallments Int              @default(1) // pagamento com cartão da agência: parcelas na fatura
  cardBillsJson    String? // [{payableId, cents}] faturas do cartão que receberam este pagamento
  createdAt        DateTime         @default(now())

  attachments    Attachment[]
  statementLines BankStatementLine[]

  @@index([companyId, date])
}

model FinancialAccount {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  type                String // BANCO | CAIXA | RECEBIVEIS | CARTAO_CREDITO | OUTRA
  closingDay          Int? // cartão de crédito da agência: dia de fechamento da fatura
  dueDay              Int? // cartão de crédito da agência: dia de vencimento da fatura
  bankName            String?
  initialBalanceCents Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  settlements    Settlement[]
  transfersOut   Transfer[]          @relation("TransferFrom")
  transfersIn    Transfer[]          @relation("TransferTo")
  statementLines BankStatementLine[]
}

model Transfer {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amountCents   Int
  date          String
  description   String?
  reversedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([companyId, date])
}

model Commission {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId      String   @unique
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  amountCents Int
  status      String // PENDENTE | PAGA | CANCELADA
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payable Payable?

  @@index([companyId, sellerId])
}

model ContractTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  productType String // tipo de produto principal atendido
  body        String // texto com variáveis {{cliente.nome}} etc.
  clauses     String   @default("") // cláusulas específicas (cancelamento, alteração)
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts Contract[]
}

model Contract {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId            String
  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  templateId        String?
  template          ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion   Int?
  status            String // NAO_GERADO | EM_PREPARACAO | AGUARDANDO_ENVIO | ENVIADO | ASSINADO | CANCELADO
  version           Int               @default(0) // versão emitida
  content           String? // conteúdo renderizado da última emissão/prévia
  missingFieldsJson String            @default("[]")
  outdated          Boolean           @default(false) // venda alterada após emissão
  issuedAt          DateTime?
  signatureProvider String?
  externalId        String?
  sentAt            DateTime?
  signUrl           String? // link de assinatura do cliente (provedor)
  signedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([companyId, saleId])
}

model AutomationSetting {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key        String
  enabled    Boolean @default(false)
  configJson String  @default("{}")

  @@unique([companyId, key])
}

model AutomationEvent {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String // venda.confirmada | pagamento.identificado | ...
  entityType     String
  entityId       String
  payloadJson    String
  idempotencyKey String
  status         String // PENDENTE | ENTREGUE | SEM_DESTINO | FALHOU | IGNORADO
  attempts       Int       @default(0)
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  dataJson   String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

model Attachment {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receivableId String?
  receivable   Receivable?      @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  payableId    String?
  payable      Payable?         @relation(fields: [payableId], references: [id], onDelete: SetNull)
  settlementId String?
  settlement   Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  saleId       String?
  sale         Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  tripId       String?
  trip         Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  invoiceId    String?
  invoice      SupplierInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind         String           @default("COMPROVANTE") // COMPROVANTE | VOUCHER | DOCUMENTO | FATURA | OUTRO | documentos do cliente (RG, CPF, CNH, PASSAPORTE...)
  docNumber    String? // número do documento do cliente (RG, passaporte...)
  docExpiry    String? // validade do documento do cliente
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime         @default(now())
}

model BankStatementLine {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId    String
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date         String
  description  String
  amountCents  Int // positivo = crédito, negativo = débito
  fingerprint  String // detecção de duplicidade
  importBatch  String
  status       String // PENDENTE | CONCILIADO | IGNORADO
  settlementId String?
  settlement   Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@unique([companyId, accountId, fingerprint])
  @@index([companyId, accountId, date])
}

/// Viagem: agrupa vendas do mesmo cliente feitas em momentos diferentes (aéreo, hotel, seguro...).
model Trip {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      Int
  code        String // VG-2026-0001
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  title       String
  destination String?
  notes       String?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales       Sale[]
  attachments Attachment[]

  @@unique([companyId, number])
  @@index([companyId, clientId])
}

/// Excursão / grupo de operação própria.
model Excursion {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number            Int
  code              String // EX-2026-0001
  name              String
  destination       String
  startDate         String
  endDate           String
  seats             Int
  pricePerSeatCents Int      @default(0)
  status            String // PLANEJADA | VENDAS_ABERTAS | ENCERRADA | REALIZADA | CANCELADA
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sales    Sale[]
  payables Payable[]

  @@unique([companyId, number])
}

/// Fatura de operadora/consolidadora: consolida contas a pagar já existentes (não cria despesa nova).
model SupplierInvoice {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  number        String // número da fatura no fornecedor
  issueDate     String
  dueDate       String
  declaredCents Int // valor cobrado na fatura do fornecedor
  status        String // ABERTA | CONFERIDA | PAGA | CANCELADA
  notes         String?
  checkedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payables    Payable[]
  attachments Attachment[]

  @@unique([companyId, supplierId, number])
  @@index([companyId, dueDate])
}

model CostCenter {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  receivables Receivable[]
  payables    Payable[]

  @@unique([companyId, name])
}

/// Regras de comissão/over por fornecedor e/ou produto, sugeridas automaticamente no lançamento da venda.
model CommissionRule {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productType   String? // vazio = qualquer produto
  description   String? // ex.: Nacional / Internacional
  commissionBps Int       @default(0) // % de comissão do fornecedor sobre o valor vendido
  overBps       Int       @default(0) // % de over/incentivo
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, supplierId])
}

/// Crédito do cliente (ex.: viagem cancelada com crédito para remarcação). Consumido por uma venda futura.
model ClientCredit {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  amountCents  Int
  reason       String
  originSaleId String? // venda cancelada que gerou o crédito
  usedSaleId   String? // venda que consumiu o crédito
  supplierName String? // onde o crédito está (operadora/cia), quando aplicável
  expiresAt    String? // validade (YYYY-MM-DD)
  status       String // ABERTO | CONSUMIDO | CANCELADO
  consumedAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId, status])
}

/// Pedido de alteração de venda já conferida pelo financeiro.
model EditRequest {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  requestedById String
  reason        String
  status        String // PENDENTE | APROVADA | REJEITADA | UTILIZADA
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([companyId, status])
}

/// Repasse entre agências (ex.: comissão de venda que caiu na fatura de outra agência do grupo).
/// Gera uma conta a pagar ou a receber, que segue o fluxo normal do financeiro.
model AgencyTransfer {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counterparty String // agência parceira
  direction    String // A_REPASSAR | A_RECEBER
  amountCents  Int
  reference    String? // fatura / venda de referência
  dueDate      String
  notes        String?
  entryId      String? // conta a pagar ou a receber gerada
  createdAt    DateTime @default(now())

  @@index([companyId, dueDate])
}

/// Metas mensais: da loja, por vendedor ou por fornecedor.
model Goal {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month            String // YYYY-MM
  scope            String // LOJA | VENDEDOR | FORNECEDOR
  targetId         String   @default("") // id do vendedor/fornecedor ("" para a loja)
  metric           String   @default("FATURAMENTO") // FATURAMENTO | RECEITA
  amountCents      Int
  superAmountCents Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, month, scope, targetId])
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String    @default("FOLLOW_UP") // FOLLOW_UP | DOCUMENTOS | PAGAMENTO | POS_VENDA | INTERNA | OUTRO
  priority    String    @default("MEDIA") // URGENTE | ALTA | MEDIA | BAIXA
  status      String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDA | CANCELADA
  dueDate     String?
  assigneeId  String?
  createdById String?
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  saleId      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, dueDate])
}

/// Categorias de despesa editáveis, organizadas em grupos (aparecem no DRE).
model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String // gravado em Payable.category
  name      String
  group     String
  inDre     Boolean  @default(true)
  active    Boolean  @default(true)
  system    Boolean  @default(false) // usada pelas regras automáticas (não pode ser excluída)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([companyId, code])
}

/// Taxa da maquininha da agência por modalidade e faixa de parcelas.
model CardFeeRate {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  modality         String // CREDITO | DEBITO
  installmentsFrom Int      @default(1)
  installmentsTo   Int      @default(1)
  rateBps          Int
  settlementDays   Int      @default(30)
  brand            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model AccessLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  email     String
  type      String // LOGIN | LOGOUT | FALHA
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Equipe da plataforma (Frédy): administra as contas das agências. Login separado em /plataforma.
model PlatformUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model PlatformAudit {
  id         String   @id @default(cuid())
  platformId String
  action     String
  companyId  String?
  dataJson   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Arquivos (comprovantes, vouchers, faturas, logos) quando o armazenamento é o próprio banco (ex.: Vercel).
model StoredFile {
  key       String   @id
  companyId String
  data      Bytes
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Integração com o CRM Frédy (API WTS) configurada pela própria agência.
model FredyIntegration {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenEnc              String // token pn_... criptografado (AES-256-GCM); nunca volta para o navegador
  tokenLast4            String
  status                String    @default("CONECTADA") // CONECTADA | ERRO | DESCONECTADA
  lastError             String?
  salesPanelId          String?
  salesPanelTitle       String?
  quoteStepId           String? // etapa onde ficam os orçamentos (opcional)
  wonStepId             String? // etapa "ganho" (além do status WON do card)
  lostStepId            String?
  fieldMapJson          String    @default("{}") // { destination, tripStart, tripEnd, passengerCount, productType } -> chave do campo personalizado
  defaultSellerId       String? // vendedor usado quando o responsável do card não tem login na gestão
  defaultProductType    String    @default("PACOTE")
  autoCreateSale        Boolean   @default(true) // card ganho cria venda (rascunho) na gestão
  syncBack              Boolean   @default(true) // venda confirmada atualiza o card (ganho, valor e nota)
  webhookKey            String    @unique // segredo na URL do webhook recebido do Frédy
  webhookSubscriptionId String?
  connectedAt           DateTime  @default(now())
  lastEventAt           DateTime?
  updatedAt             DateTime  @updatedAt
}

/// Eventos recebidos do Frédy (registro para conferência e idempotência).
model FredyWebhookEvent {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType String
  entityId  String?
  status    String // PROCESSADO | IGNORADO | ERRO
  message   String?
  saleId    String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Cada envio para assinatura eletrônica (base para a cobrança da plataforma às agências).
model SignatureRequest {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId String
  saleId     String
  provider   String // ZAPSIGN
  externalId String    @unique // token do documento no provedor
  costCents  Int
  status     String // ENVIADO | ASSINADO | RECUSADO
  createdAt  DateTime  @default(now())
  signedAt   DateTime?

  @@index([companyId, createdAt])
}

/// Configurações internas da plataforma (chave-valor), ex.: id do webhook da ZapSign.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Importação de clientes do Monde pela API oficial (https://github.com/monde-sistemas/monde-api).
model MondeIntegration {
  id           String    @id @default(cuid())
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  login        String // usuario@agencia.monde.com.br
  passwordEnc  String // senha criptografada (AES-256-GCM)
  status       String    @default("CONECTADA") // CONECTADA | ERRO
  lastError    String?
  nextPage     Int       @default(1) // próxima página da importação em andamento
  totalPages   Int?
  importing    Boolean   @default(false)
  createdCount Int       @default(0)
  updatedCount Int       @default(0)
  skippedCount Int       @default(0)
  lastImportAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
